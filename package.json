{
  "name": "digitaloffices",
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "build": "turbo run build",
    "start": "pnpm --filter api start",

    "db:generate": "pnpm --filter @repo/database db:generate",
    "db:migrate": "pnpm --filter @repo/database db:push",
    "db:migrate:sql": "pnpm --filter @repo/database db:push",
    "db:studio": "pnpm --filter @repo/database db:studio"
  },
  "devDependencies": {
    "turbo": "^2.8.10"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0"
  }
}
